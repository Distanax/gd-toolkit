{
  "problemMatcher": [
    {
      "owner": "cxx-error",
      "pattern": [
        {
          "regexp": "^\\s*(?:\\d+>)?((\\S.*?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error)\\s*(\\w*)\\s*:.*)$",
          "message": 1, "file": 2, "line": 3, "column": 4, "severity": 5, "code": 6
        }
      ]
    },
    {
      "owner": "cxx-error-colon",
      "pattern": [
        {
          "regexp": "^\\s*(([A-Za-z]:[\\\\/].*?|/.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(error):.*)$",
          "message": 1, "file": 2, "line": 3, "column": 4, "severity": 5
        }
      ]
    },
    {
      "owner": "link-error",
      "pattern": [
        {
          "regexp": "^\\s*((lld-link|LINK|link\\.exe|ld\\.lld)\\s*:\\s*(?:fatal\\s+)?(error)\\s*(\\w*)\\s*:?.*)$",
          "message": 1, "file": 2, "severity": 3, "code": 4
        }
      ]
    },
    {
      "owner": "cmake-error",
      "pattern": [
        {
          "regexp": "^((CMake Error)(?: at (.+?):(\\d+))?.*)$",
          "message": 1, "severity": 2, "file": 3, "line": 4
        }
      ]
    }
  ]
}
